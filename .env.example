# Copy to .env and fill in. Never commit .env.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=anthropic/claude-haiku-5-5

# Agent wallet (generate with: node scripts/gen-agent-key.mjs)
NEAR_AGENT_ACCOUNT_ID=
NEAR_AGENT_PUBLIC_KEY=
NEAR_AGENT_PRIVATE_KEY=

# Optional: NEAR Intents partner JWT (partners.near-intents.org)
INTENTS_JWT=

# Orbi routing fee (Rhea SmartRouterV2 appFeeRate, in per mille: 1 = 0.1%, max 1000)
ORBI_FEE_RECIPIENT=
ORBI_FEE_PER_MILLE=0

# Voice (ElevenLabs, optional). Without these Orbi uses the browser voice.
# Pick a voice id with: node --env-file=.env scripts/list-voices.mjs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_STABILITY=0.4
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.0
ORBI_TTS_DAILY_CHARS=20000

# Execution: off = lookups only; rehearsal = full flow, nothing is ever signed or sent (default); live = REAL transactions.
# Live is never the default. Start with a few dollars. NEAR Intents and Rhea only exist on mainnet.
ORBI_EXECUTION=rehearsal
ORBI_NETWORK=mainnet
ORBI_MIN_RESERVE_NEAR=0.2        # always keep this much NEAR for fees and storage
ORBI_MAX_NEW_ADDRESS_USD=5       # cap for a first payment to a new contact
ORBI_MAX_DRIFT_PCT=1             # cancel a swap if the fresh quote is this much worse than the approved one
ORBI_PENDING_TTL_SEC=120         # an approval card expires after this long

# Policy limits (USD)
ORBI_MAX_ACTION_USD=10
ORBI_MAX_DAILY_USD=25

# Bringing USDC in from Base through NEAR Intents (optional). Your own Base address for refunds can also be saved in Settings.
# ORBI_BASE_REFUND_ADDRESS=0x...
# ORBI_MAX_BRIDGE_USD=100
# ORBI_BRIDGE_DEADLINE_MIN=60

# Hosting a shared copy (optional). Off by default: running on your own computer keeps everything exactly as it is.
# ORBI_MULTIUSER=on          # each browser gets a private id (cookie): its own memory, contacts and refund address
#                            # also forces rehearsal (nothing is signed) and turns the Base deposit off, because the wallet is shared
# ORBI_ALLOWED_HOSTS=your-demo.example.com
# ORBI_TRUST_PROXY=1         # behind a proxy, rate-limit by the real client address
# ORBI_COOKIE_SECURE=1       # when served over https
# ORBI_MAX_OWNERS=2000       # stop taking new visitors beyond this many
# A shared demo that uses a small LIVE wallet (real funds, tiny amounts): also set
# ORBI_ALLOW_PUBLIC_LIVE=1, ORBI_EXECUTION=live, ORBI_MAX_ACTION_USD=0.5, ORBI_MAX_DAILY_USD=5, ORBI_MAX_LIVE_ACTIONS_PER_DAY=20
# ORBI_MAX_LIVE_ACTIONS_PER_VISITOR=3   # per browser per day (cookie based; the shared daily caps are the real backstop)
# ORBI_MAX_LIVE_ACTIONS_PER_IP=6        # per network address per day (needs ORBI_TRUST_PROXY=1 behind Railway); only a short hash is logged
# ORBI_MAX_LIVE_SENDS_PER_DAY=5  ORBI_MAX_LIVE_SEND_USD_PER_DAY=2.5   # sends to Treasury, all visitors together
# On Railway (one instance, with a volume mounted at /data): HOST is chosen automatically; put the files on the volume:
# ORBI_DATA_DIR=/data  ORBI_ACTIVITY_FILE=/data/activity.jsonl  ORBI_TTS_CACHE_DIR=/data/tts  ORBI_RESEARCH_CACHE=/data/research.json
# Start command: npm start   (it does not read a .env file; set every variable in the platform settings)
# On a shared demo: the only contact is Treasury (ORBI_FEE_RECIPIENT), contacts can't be added, Base deposits are off,
# live actions run one at a time, and the daily dollar and action-count caps are shared by all visitors.
